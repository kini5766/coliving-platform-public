meta {
  name: 16 7-6 한 문서만 다시 반영 ⚠Gemini
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/community-service/admin/faq-documents/reindex
  body: json
  auth: none
}

headers {
  X-User: {{adminId}}
}

body:json {
  {
    "documentIds": [{{faqMangwonDocId}}]
  }
}

script:post-response {
  if (res.status === 202) bru.setEnvVar("faqJobId", res.body.jobId);
}
