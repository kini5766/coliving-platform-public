meta {
  name: 01 7-3 공통 FAQ 업로드 (DOCX)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/community-service/admin/faq-documents
  body: multipartForm
  auth: none
}

headers {
  X-User: {{adminId}}
}

body:multipart-form {
  title: 룸링크 이용 안내 FAQ
  scope: COMMON
  file: @file(faq-samples/roomlink-common-faq.docx)
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("faqCommonDocId", res.body.documentId);
}
