meta {
  name: 03 7-3 성수 하우스 안내 업로드 (MD)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/community-service/admin/faq-documents
  body: multipartForm
  auth: none
}

headers {
  X-User: {{adminId}}
}

body:multipart-form {
  title: 성수 하우스 생활 안내
  scope: BUILDING
  buildingId: 2
  file: @file(faq-samples/seongsu-house-guide.md)
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("faqSeongsuDocId", res.body.documentId);
}
