meta {
  name: 01 준비 - 5001 글 작성
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/community-service/posts
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "category": "FREE",
    "title": "302호 세탁기가 고장났어요",
    "content": "3층 세탁실 2번 세탁기가 멈췄어요. 언제 고쳐질까요?"
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("postId", res.body.postId);
}
