# 샘플만 커밋한다. 값을 채운 뒤 coliving-app.yaml 로 저장하고 클러스터에 적용한다.
# 이 파일은 kustomization 에 없다. Argo CD Sync 로 덮어쓰지 않는다.
# Config 저장소 YAML 의 ${NAVER_CLIENT_ID} 같은 자리가 이 값으로 채워진다.
apiVersion: v1
kind: Secret
metadata:
  name: coliving-app
  namespace: coliving
  labels:
    app.kubernetes.io/part-of: coliving-platform
type: Opaque
stringData:
  NAVER_CLIENT_ID: ""
  NAVER_CLIENT_SECRET: ""
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  KAKAOPAY_SECRET_KEY: ""
  KAKAOPAY_CID: ""
  MAIL_USERNAME: ""
  MAIL_APP_PASSWORD: ""
  PORTONE_STORE_ID: ""
  PORTONE_API_SECRET: ""
  GEMINI_API_KEY: ""
  USER_CRYPTO_KEY: ""
  COMMUNITY_CRYPTO_KEY: ""
  JWT_PUBLIC_KEY: ""
  JWT_PRIVATE_KEY: ""
