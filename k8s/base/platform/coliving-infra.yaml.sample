# 샘플만 커밋한다. 값을 채운 뒤 coliving-infra.yaml 로 저장하고 클러스터에 적용한다.
# 이 파일은 kustomization 에 없다. Argo CD Sync 로 덮어쓰지 않는다.
# redis-password 를 빈 문자열로 두면 Redis AUTH 를 하지 않는다.
apiVersion: v1
kind: Secret
metadata:
  name: coliving-infra
  namespace: coliving
  labels:
    app.kubernetes.io/part-of: coliving-platform
type: Opaque
stringData:
  postgres-user: ""
  postgres-password: ""
  rabbitmq-user: ""
  rabbitmq-password: ""
  redis-password: ""
  grafana-admin-user: ""
  grafana-admin-password: ""
